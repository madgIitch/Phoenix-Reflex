# Cloud Run sets PORT automatically. Use 8080 locally if unset.
PORT=8080

# Arize AX tracing. Use the values from your Arize AX space.
ARIZE_API_KEY=replace-with-your-arize-ax-api-key
ARIZE_SPACE_ID=replace-with-your-arize-ax-space-id
ARIZE_PROJECT_NAME=phoenix-reflex
# EU region because the app URL is app.eu-west-1a.arize.com.
ARIZE_OTEL_ENDPOINT=https://otlp.eu-west-1a.arize.com/v1

# Gemini. The Google GenAI docs use GEMINI_API_KEY.
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Google ADK also accepts GOOGLE_API_KEY; keep the same value for compatibility.
GOOGLE_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_JUDGE_MODEL=gemini-2.5-flash

# Optional Phoenix Cloud fallback, only if you switch from Arize AX to Phoenix.
# PHOENIX_API_KEY=px_live_...
# PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/your-space
# PHOENIX_PROJECT_NAME=phoenix-reflex

# Optional Sprint 3 Phoenix MCP integration. Disabled by default for Arize AX.
ENABLE_PHOENIX_MCP=0
# PHOENIX_HOST=https://app.phoenix.arize.com/s/your-space
