# Cloud Run sets PORT automatically. Use 8080 locally if unset.
PORT=8080

# Phoenix Cloud tracing. Use a Phoenix API key, not an Arize AX key.
PHOENIX_API_KEY=replace-with-your-phoenix-api-key
# Copy the Hostname from Phoenix Cloud settings. It should include /s/<space>.
# Example: https://app.phoenix.arize.com/s/your-space
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/your-space
PHOENIX_PROJECT_NAME=phoenix-reflex

# ADK / Gemini.
GOOGLE_API_KEY=replace-with-your-google-api-key
GEMINI_MODEL=gemini-2.5-flash
